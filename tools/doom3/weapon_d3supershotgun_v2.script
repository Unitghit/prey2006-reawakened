// Prey firing-controller adapter for locally imported Doom 3 supershotgun assets.
scriptEvent void fireSingleBarrel();
object weapon_d3supershotgun_v2 : weapon_base {
    void init();
    void Idle();
    void Fire();
    void AltFire();
    void Reload();
};

void weapon_d3supershotgun_v2::init() {
    nextAttack = 0;
    WEAPON_ALTMODE = false;
}

void weapon_d3supershotgun_v2::Idle() {
    weaponReady();
    PlayCycle("idle");
    while (1) {
        CheckLower(2);
        CheckAside(2);
        if (WEAPON_ATTACK && sys.getTime() >= nextAttack) {
            if (ammoInClip() >= 2) {
                PerformAction("Fire", 0);
            } else if (ammoAvailable() > ammoInClip()) {
                PerformAction("Reload", 2);
            } else {
                StartSound("snd_empty", SND_CHANNEL_WEAPON, false);
                nextAttack = sys.getTime() + 0.4;
            }
        }
        if (WEAPON_ALTATTACK && !WEAPON_ATTACK && sys.getTime() >= nextAttack) {
            if (ammoInClip() >= 1) {
                PerformAction("AltFire", 0);
            } else if (ammoAvailable() > ammoInClip()) {
                PerformAction("Reload", 2);
            } else {
                StartSound("snd_empty", SND_CHANNEL_WEAPON, false);
                nextAttack = sys.getTime() + 0.4;
            }
        }
        if (WEAPON_RELOAD && ammoInClip() < clipSize() && ammoAvailable() > ammoInClip()) {
            PerformAction("Reload", 2);
        }
        waitFrame();
    }
}

void weapon_d3supershotgun_v2::Fire() {
    nextAttack = sys.getTime() + 2.2;
    PlayAnim("fire");
    setShaderParm(SHADERPARM_TIMEOFFSET, -sys.getTime());
    setShaderParm(SHADERPARM_DIVERSITY, sys.random(1));
    fireProjectiles();
    if (sys.getcvarFloat("d3_supershotgunTrace") == 1) {
        sys.println("D3SHOT fired clip=" + ammoInClip());
    }
    while (!animDone(ANIMCHANNEL_ALL, 0)) {
        CheckLower(2);
        CheckAside(2);
        waitFrame();
    }
    if (ammoAvailable() > ammoInClip()) { PerformAction("Reload", 2); }
    PerformAction("Idle", 0);
}

void weapon_d3supershotgun_v2::AltFire() {
    nextAttack = sys.getTime() + 2.2;
    PlayAnim("fire");
    setShaderParm(SHADERPARM_TIMEOFFSET, -sys.getTime());
    setShaderParm(SHADERPARM_DIVERSITY, sys.random(1));
    fireSingleBarrel();
    if (sys.getcvarFloat("d3_supershotgunTrace") == 1) {
        sys.println("D3SHOT single clip=" + ammoInClip());
    }
    while (!animDone(ANIMCHANNEL_ALL, 0)) {
        CheckLower(2);
        CheckAside(2);
        waitFrame();
    }
    // Keep the other barrel ready, instead of forcing a reload after one shot.
    if (ammoInClip() == 0 && ammoAvailable() > 0) { PerformAction("Reload", 2); }
    PerformAction("Idle", 0);
}

void weapon_d3supershotgun_v2::Reload() {
    weaponReloading();
    PlayAnim("reload");
    while (!animDone(ANIMCHANNEL_ALL, 0)) {
        CheckLower(2);
        CheckAside(2);
        waitFrame();
    }
    addToClip(clipSize());
    if (sys.getcvarFloat("d3_supershotgunTrace") == 1) {
        sys.println("D3SHOT reload clip=" + ammoInClip() + " available=" + ammoAvailable());
    }
    PerformAction("Idle", 0);
}
