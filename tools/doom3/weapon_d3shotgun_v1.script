// Prey firing-controller adapter for locally imported Doom 3 shotgun assets.
object weapon_d3shotgun : weapon_base {
    void init();
    void Idle();
    void Fire();
    void Reload();
};

void weapon_d3shotgun::init() {
    nextAttack = 0;
    WEAPON_ALTMODE = false;
}

void weapon_d3shotgun::Idle() {
    weaponReady();
    PlayCycle("idle");
    while (1) {
        CheckLower(2);
        CheckAside(2);
        if (WEAPON_ATTACK && sys.getTime() >= nextAttack) {
            if (ammoInClip() > 0) {
                PerformAction("Fire", 0);
            } else if (ammoAvailable() > 0) {
                PerformAction("Reload", 2);
            } else {
                StartSound("snd_empty", SND_CHANNEL_WEAPON, false);
                nextAttack = sys.getTime() + 0.4;
            }
        }
        if (WEAPON_RELOAD && ammoInClip() < clipSize() && ammoAvailable() > ammoInClip()) {
            PerformAction("Reload", 2);
        }
        waitFrame();
    }
}

void weapon_d3shotgun::Fire() {
    nextAttack = sys.getTime() + 1.333;
    PlayAnim("fire");
    setShaderParm(SHADERPARM_TIMEOFFSET, -sys.getTime());
    setShaderParm(SHADERPARM_DIVERSITY, sys.random(1));
    fireProjectiles();
    if (sys.getcvarFloat("d3_shotgunTrace") == 1) {
        sys.println("D3SHOT fired clip=" + ammoInClip());
    }
    while (!animDone(ANIMCHANNEL_ALL, 0)) {
        CheckLower(2);
        CheckAside(2);
        waitFrame();
    }
    PerformAction("Idle", 0);
}

void weapon_d3shotgun::Reload() {
    weaponReloading();
    PlayAnim("reload_start");
    while (!animDone(ANIMCHANNEL_ALL, 0)) {
        CheckLower(2);
        CheckAside(2);
        waitFrame();
    }
    while (ammoInClip() < clipSize() && ammoAvailable() > ammoInClip()) {
        PlayAnim("reload_loop");
        while (!animDone(ANIMCHANNEL_ALL, 0)) {
            CheckLower(2);
            CheckAside(2);
            waitFrame();
        }
        addToClip(2);
        if (sys.getcvarFloat("d3_shotgunTrace") == 1) {
            sys.println("D3SHOT reloaded clip=" + ammoInClip());
        }
        if (WEAPON_ATTACK) {
            break;
        }
    }
    PlayAnim("reload_end");
    while (!animDone(ANIMCHANNEL_ALL, 0)) {
        CheckLower(2);
        CheckAside(2);
        waitFrame();
    }
    PerformAction("Idle", 0);
}
