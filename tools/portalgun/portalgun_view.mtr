reawakened/portalgun/view/v_portalgun {
    noSelfShadow
    bumpmap textures/reawakened/portalgun/v_portalgun_normal.tga
    diffusemap textures/reawakened/portalgun/v_portalgun.tga
    specularmap textures/reawakened/portalgun/specular.tga
}
reawakened/portalgun/view/v_hands {
    noSelfShadow
    diffusemap textures/reawakened/portalgun/v_hands.tga
}
reawakened/portalgun/view/v_portalgun_glass {
    noShadows
    translucent
    {
        blend add
        map textures/reawakened/portalgun/v_portalgun_glass.tga
        red parm5
        green 0.35
        blue 1-parm5
    }
}
